type 'v inst = A of 'v
             | C of cinst

type jinst = JGT
           | JEQ
           | JGE
           | JLT
           | JNE
           | JLE
           | JMP
           

let map f = function
          | A x -> A (f x)
          | C i -> C i


type computation = const | unary | binary

type dest = M
	      | D
	      | MD
	      | A
 	      | AM
	      | AD      
          | AMD

type cinst = { destination = dest option;
               output      = computation option;
               jump        = jinst option
             }


type const = Zero | One    | MinusOne
type unary = Bneg | UMinus | Succ    | Pred | ID
type binary = Add | Sub    | SubFrom | BAnd | BOr




     
